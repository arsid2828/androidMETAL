<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.prova1.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.prova1.SettingsFragment"
        android:label="Impostazioni"
        tools:layout="@xml/preferences" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.prova1.NotificationsFragment"
        android:label="Notifiche"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/allerteFragment"
        android:name="com.example.prova1.AllerteFragment"
        android:label="Allerte"
        tools:layout="@layout/fragment_allerte">
        <action
            android:id="@+id/action_AllerteFragment_to_GhiaccioNeveFragment"
            app:destination="@id/ghiaccioNeveFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_TemporaliFragment"
            app:destination="@id/temporaliFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_NebbiaFragment"
            app:destination="@id/nebbiaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_PioggiaFragment"
            app:destination="@id/pioggiaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_VentoFragment"
            app:destination="@id/ventoFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_TemperaturaFragment"
            app:destination="@id/temperaturaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_QualitaAriaFragment"
            app:destination="@id/qualitaAriaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_RaggiUvFragment"
            app:destination="@id/raggiUvFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_InondazioneFragment"
            app:destination="@id/inondazioneFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_InondazionePioggiaFragment"
            app:destination="@id/inondazionePioggiaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_SiccitaFragment"
            app:destination="@id/siccitaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_EventoCostieroFragment"
            app:destination="@id/eventoCostieroFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_IncendioFragment"
            app:destination="@id/incendioFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_ValangaFragment"
            app:destination="@id/valangaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_PericoloMarinoFragment"
            app:destination="@id/pericoloMarinoFragment" />
    </fragment>

    <fragment android:id="@+id/ghiaccioNeveFragment" android:name="com.example.prova1.GhiaccioNeveFragment" android:label="Ghiaccio e Neve"/>
    <fragment android:id="@+id/temporaliFragment" android:name="com.example.prova1.TemporaliFragment" android:label="Temporali"/>
    <fragment android:id="@+id/nebbiaFragment" android:name="com.example.prova1.NebbiaFragment" android:label="Nebbia"/>
    <fragment android:id="@+id/pioggiaFragment" android:name="com.example.prova1.PioggiaFragment" android:label="Pioggia"/>
    <fragment android:id="@+id/ventoFragment" android:name="com.example.prova1.VentoFragment" android:label="Vento"/>
    <fragment android:id="@+id/temperaturaFragment" android:name="com.example.prova1.TemperaturaFragment" android:label="Temperatura"/>
    <fragment android:id="@+id/qualitaAriaFragment" android:name="com.example.prova1.QualitaAriaFragment" android:label="Qualità dell'Aria"/>
    <fragment android:id="@+id/raggiUvFragment" android:name="com.example.prova1.RaggiUvFragment" android:label="Raggi UV"/>
    <fragment android:id="@+id/inondazioneFragment" android:name="com.example.prova1.InondazioneFragment" android:label="Inondazione"/>
    <fragment android:id="@+id/inondazionePioggiaFragment" android:name="com.example.prova1.InondazionePioggiaFragment" android:label="Inondazione e Pioggia"/>
    <fragment android:id="@+id/siccitaFragment" android:name="com.example.prova1.SiccitaFragment" android:label="Siccità"/>
    <fragment android:id="@+id/eventoCostieroFragment" android:name="com.example.prova1.EventoCostieroFragment" android:label="Evento Costiero"/>
    <fragment android:id="@+id/incendioFragment" android:name="com.example.prova1.IncendioFragment" android:label="Incendio"/>
    <fragment android:id="@+id/valangaFragment" android:name="com.example.prova1.ValangaFragment" android:label="Valanga"/>
    <fragment android:id="@+id/pericoloMarinoFragment" android:name="com.example.prova1.PericoloMarinoFragment" android:label="Pericolo Marino"/>

</navigation>