            android:id="@+id/action_AllerteFragment_to_SiccitaFragment"
            app:destination="@id/SiccitaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_EventoCostieroFragment"
            app:destination="@id/EventoCostieroFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_IncendioFragment"
            app:destination="@id/IncendioFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_ValangaFragment"
            app:destination="@id/ValangaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_PericoloMarinoFragment"
            app:destination="@id/PericoloMarinoFragment" />
