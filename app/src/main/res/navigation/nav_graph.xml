    <fragment
        android:id="@+id/GhiaccioNeveFragment"
        android:name="com.example.prova1.GhiaccioNeveFragment"
        android:label="Ghiaccio e Neve"
        tools:layout="@layout/fragment_ghiaccio_neve" />

    <fragment
