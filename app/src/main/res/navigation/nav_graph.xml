        android:name="com.example.prova1.AllerteFragment"
        android:label="Allerte"
        tools:layout="@layout/fragment_allerte">
        <action
            android:id="@+id/action_AllerteFragment_to_GhiaccioNeveFragment"
            app:destination="@id/GhiaccioNeveFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_TemporaliFragment"
            app:destination="@id/TemporaliFragment" />
