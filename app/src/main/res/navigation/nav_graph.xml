            android:id="@+id/action_AllerteFragment_to_NebbiaFragment"
            app:destination="@id/NebbiaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_PioggiaFragment"
            app:destination="@id/PioggiaFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_VentoFragment"
            app:destination="@id/VentoFragment" />
        <action
            android:id="@+id/action_AllerteFragment_to_TemperaturaFragment"
            app:destination="@id/TemperaturaFragment" />
