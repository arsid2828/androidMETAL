<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TemperaturaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPERATURA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Blu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_blue"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVELLO 1 - GELO (Colore: Blu)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: Temperatura inferiore a -5°C\nDescrizione: Freddo intenso, ghiaccio su strade e marciapiedi. Rischio di congelamento e ipotermia in pochi minuti all\'aperto." />
        </LinearLayout>

        <!-- Livello Ciano -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_cyan"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVELLO 2 - FREDDO (Colore: Azzurro/Ciano)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: Temperatura da -4°C a 2°C\nDescrizione: Temperature basse, percezione di freddo accentuata dal vento o umidità. Rischio di ipotermia per esposizioni prolungate." />
        </LinearLayout>

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVELLO 3 - CALDO (Colore: Arancione)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: Temperatura da 34°C a 37°C\nDescrizione: Caldo intenso, afa elevata. Rischio di colpi di calore e disidratazione." />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVELLO 4 - CALDO ESTREMO (Colore: Rosso)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: Temperatura superiore a 38°C\nDescrizione: Caldo pericoloso per la salute, ondata di calore. Rischio di colpo di calore grave, disidratazione acuta, mortalità aumentata." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>