<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".PioggiaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌧️ PIOGGIA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Giallo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_yellow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 GIALLO (Allerta Moderata - Possibili disagi)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nPioggia persistente e moderata. Precipitazioni che possono causare allagamenti localizzati in zone basse o con scarichi inefficienti.\nIstruzioni:\nIn auto: Guidare con prudenza, aumentare la distanza di sicurezza per rischio di aquaplaning su asfalto bagnato.\nIn zones a rischio: Monitorare piccoli corsi d'acqua e fossi." />
        </LinearLayout>

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟠 ARANCIONE (Allerta Elevata - Fenomeni intensi)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nPiogge intense e/o prolungate. Nubifragi localizzati che possono causare rapidi rigonfiamenti di torrenti.\nIstruzioni:\nIn auto: EVITARE di transitare in sottopassi, strade allagate o vicino agli argini di fossi e torrenti in piena." />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 ROSSO (Allerta Massima - Emergenza per piogge eccezionali/alluvione)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nPiogge torrenziali, persistenti e diffuse su ampia area. Nubifragi estremi con altissimo rischio di alluvioni lampo.\nIstruzioni:\nNON METTERSI IN VIAGGIO PER NESSUN MOTIVO. Restare in casa ai piani più alti, lontani da seminterrati e cantine.\nSe ci si trova all'aperto, cercare immediatamente rifugio in un'area rialzata e sicura. NON tentare di tornare a casa o raggiungere la macchina se le acque stanno salendo rapidamente.\nSeguire immediatamente le indicazioni delle autorità (Protezione Civile, Vigili del Fuoco, Comune) che potrebbero ordinare l'evacuazione dell'area." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>