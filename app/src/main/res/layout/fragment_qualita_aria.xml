<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".QualitaAriaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😷 QUALITÀ DELL'ARIA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟠 QUALITÀ SCARSA"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: PM2.5 da 25 a 49 µg/m³\nDescrizione: Inquinamento moderato. Possibili effetti sulla salute di gruppi sensibili" />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 QUALITÀ MOLTO SCARSA"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: PM2.5 da 50 a 74 µg/m³\nDescrizione: Inquinamento elevato. Effetti sulla salute per tutti. Possibili sintomi respiratori anche in persone sane." />
        </LinearLayout>

        <!-- Livello Viola -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_purple"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ QUALITÀ NOCIVA"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Range: PM2.5 superiore a 75 µg/m³\nDescrizione: Inquinamento molto elevato. Emergenza sanitaria. Rischio di gravi effetti sulla salute anche con esposizioni brevi." />
        </LinearLayout>

        <!-- Nota Tecnica -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 NOTA TECNICA:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="16dp"
                android:text="PM2.5 = Particulate Matter 2.5 (particolato fine con diametro ≤ 2,5 micron)\nValori misurati in microgrammi per metro cubo (µg/m³) - media 24h\nPer confronto: L'OMS raccomanda valori inferiori a 5 µg/m³ (media annuale)\nL'inquinamento peggiora con condizioni meteo stabili (alta pressione, assenza di vento)\nLe ore peggiori sono generalmente la mattina presto (7-9) e la sera (18-20)" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>