<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".AllerteFragment">

        <!-- Intestazione -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_header_white"
            android:padding="16dp"
            android:text="Il numero da chiamare in caso di emergenza è il 112 e si prega di selezionare l'allerta interessata seguendo le normative scritte al suo interno:"
            android:textColor="@color/header_red"
            android:textSize="21sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- Lista Allerte -->
        <TextView
            android:id="@+id/normativa_ghiaccio_neve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🧊 Ghiaccio e neve"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_temporali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="⛈️ Temporali"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_nebbia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌫️ Nebbia e Visibilità"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_pioggia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌧️ Pioggia"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_vento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="💨 Vento"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_temperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌡️ Temperatura"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_qualita_aria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="😷 Qualità dell'aria"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_raggi_uv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="☀️ Raggi UV"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_inondazioni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌊 Inondazioni"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_inondazione_pioggia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌧️ Inondazione da Pioggia"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_siccita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🏜️ Siccità"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_evento_costiero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌅 Evento Costiero"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_incendio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🔥 Incendio Boschivo"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_valanga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🏔️ Valanga"
            android:textSize="20sp"
            android:elevation="1dp" />

        <TextView
            android:id="@+id/normativa_pericolo_marino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_corner_cream"
            android:clickable="true"
            android:focusable="true"
            android:padding="16dp"
            android:text="🌊 Pericolo Marino"
            android:textSize="20sp"
            android:elevation="1dp" />

    </LinearLayout>
</ScrollView>