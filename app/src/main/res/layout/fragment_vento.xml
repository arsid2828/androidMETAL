<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".VentoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨 VENTO"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Giallo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_yellow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 LIVELLO 1 - GIALLO (Allerta Moderata)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Intensità:\nVenti da 30 a 44 km/h - Vento moderato/sostenuto\nDescrizione:\nRischio di rami spezzati, oggetti leggeri spostati. Fastidio per pedoni e ciclisti. Possibili difficoltà per mezzi alti (furgoni, camper)." />
        </LinearLayout>

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟠 LIVELLO 2 - ARANCIONE (Allerta Elevata)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Intensità:\nVenti da 45 a 69 km/h - Burrasca forte\nDescrizione:\nPossibili danni a tegole, insegne, pensiline. Rami di media grandezza possono cadere. Possibili interruzioni di corrente localizzate." />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 LIVELLO 3 - ROSSO (Allerta Massima)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Intensità:\nVenti da 70 a 149 km/h - Tempesta/forte burrasca\nDescrizione:\nDanni diffusi (tetti scoperchiati, alberi sradicati, linee elettriche interrotte). Pericolo per l'incolumità delle persone all'aperto. Trasporti fortemente compromessi. Rischio di mareggiate sulle coste." />
        </LinearLayout>

        <!-- Livello Viola -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_purple"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ LIVELLO 4 - VIOLA (Pericolo Estremo - Condizioni Uragano)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Intensità:\nVenti superiori a 150 km/h - Uragano/tempesta violenta\nDescrizione:\nCondizioni estreme e distruttive. Danni strutturali molto gravi. Pericolo di vita reale per chiunque si trovi all'esterno. Fenomeni rari in Italia, possibili durante cicloni mediterranei (medicane) o tempeste eccezionali." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>