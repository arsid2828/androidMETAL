<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".GhiaccioNeveFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧊 GHIACCIO e NEVE"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Giallo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_yellow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 GIALLO (Allerta Moderata - Attenzione)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nFormazione di ghiaccio o inizio di nevicata su strade secondarie. Strade fredde e umide con rischio di lastre di ghiaccio..\nIstruzioni:\nIn auto: Ridurre la velocità, aumentare la distanza di sicurezza, evitare manovre brusche.\nA piedi: Camminare con cautela, preferire superfici ruvide o ghiaiose." />
        </LinearLayout>

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟠 ARANCIONE (Allerta Elevata - Massima Precauzione)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nNeve che persiste e si accumula su tutte le strade. Formazione diffusa di ghiaccio. Temperature ampiamente sotto lo zero.\nIstruzioni:\nIn auto: Viaggiare SOLO se strettamente necessario. Montare catene o pneumatici invernali omologati.\nA piedi: Evitare di uscire se possibile, soprattutto anziani e persone con difficoltà motorie." />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 ROSSO (Allerta Massima - Emergenza)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nForti bufere di neve, tempeste di ghiaccio, accumuli molto elevati che bloccano le strade e isolano paesi.\nIstruzioni:\nNON METTERSI IN VIAGGIO. Restare a casa o in un luogo sicuro.\nSeguire le istruzioni delle autorità (Protezione Civile, Vigili del Fuoco)." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>