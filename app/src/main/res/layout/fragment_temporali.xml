<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TemporaliFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛈️ TEMPORALI"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Livello Giallo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_corner_yellow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 GIALLO (Allerta Moderata - Possibili fenomeni intensi)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nTemporali localizzati, brevi ma intensi, con possibile grandine isolata, raffiche di vento forti, rovesci.\nIstruzioni:\nRimanere informati sull'evoluzione meteo.\nIn auto, prestare attenzione a forti raffiche di vento laterali e aquaplaning." />
        </LinearLayout>

        <!-- Livello Arancione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_orange"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟠 ARANCIONE (Allerta Elevata - Fenomeni pericolosi)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nTemporali forti, organizzati in linee, con grandine frequente, venti molto forti (burrasca), possibili tornado o downburst.\nIstruzioni:\nIn auto, evitare sottopassi o strade allagabili. Fermarsi in area sicura se la visibilità diventa nulla.\nNON sostare sotto alberi, pensiline, strutture leggere. NON usare apparecchiature elettriche collegate alla rete o il telefono fisso." />
        </LinearLayout>

        <!-- Livello Rosso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner_red"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 ROSSO (Allerta Massima - Fenomeni violenti)"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:lineSpacingExtra="4dp"
                android:text="Condizioni:\nNubifragi con allagamenti lampo, grandine di grosse dimensioni, venti devastanti (tempesta), tornado.\nIstruzioni:\nRimanere in casa, nel luogo più sicuro (interno, lontano da muri esterni e vetrate).\nSe negli scantinati, salire ai piani superiori a causa del rischio allagamento lampo." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>